rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'fajrisani12@gmail.com' ||
        request.auth.token.email == 'owner@astraisuzu.co.id'
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /goodReceipts/{grId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;

      match /items/{itemId} {
        allow read, write: if true;
      }
    }
  }
}
